---
import { strings, home, type Lang } from "../i18n/strings";
interface Props {
  lang: Lang;
  altHref: string;
}
const { lang, altHref } = Astro.props;
const t = strings[lang].nav;
const h = home(lang);
---

<header class="nav" data-nav>
  <a class="nav__logo t-display" href={h} data-hover aria-label="Noruzo">
    NORU<span class="t-tilt">zo</span>
  </a>
  <nav class="nav__links" aria-label="Primary">
    <a class="t-label" href={`${h}#services`} data-hover>{t.services}</a>
    <a class="t-label" href={`${h}#process`} data-hover>{t.process}</a>
    <a class="t-label" href={`${h}#work`} data-hover>{t.work}</a>
    <a class="t-label" href={`${h}#contact`} data-hover>{t.contact}</a>
  </nav>
  <div class="nav__right">
    <a class="nav__lang t-label" href={altHref} hreflang={lang === "en" ? "es" : "en"} lang={lang === "en" ? "es" : "en"} aria-label={t.switchLabel} data-hover>{t.switchShort}</a>
    <a class="nav__cta t-label" href={`${h}#contact`} data-hover>{t.cta}</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
    padding: 0 var(--gutter);
    mix-blend-mode: difference;
    color: #fff;
  }

  .nav__logo {
    font-size: 1.35rem;
    line-height: 1;
  }

  .nav__logo .t-tilt {
    color: #fff;
  }

  .nav__links {
    display: flex;
    gap: 2rem;
  }

  .nav__links a {
    position: relative;
  }

  .nav__links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .nav__links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav__right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav__lang {
    opacity: 0.8;
    transition: opacity 0.3s;
  }

  .nav__lang:hover {
    opacity: 1;
  }

  .nav__cta {
    border: 1px solid currentColor;
    border-radius: 99px;
    padding: 0.6rem 1.2rem;
    transition:
      background-color 0.3s var(--ease-out-expo),
      color 0.3s var(--ease-out-expo);
  }

  .nav__cta:hover {
    background: #fff;
    color: #000;
  }

  @media (max-width: 640px) {
    .nav__links {
      display: none;
    }
  }
</style>
