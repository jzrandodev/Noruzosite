---
import { getCollection } from "astro:content";
import SectionHead from "./SectionHead.astro";
import CaseVisual from "./CaseVisual.astro";
import { strings, caseUrl, type Lang } from "../i18n/strings";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = strings[lang].cases;
const cases = (await getCollection("case-studies", (c) => c.data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section class="cases section" id="work" data-theme-section="dark">
  <SectionHead chip={t.chip} title={t.title} sub={t.sub} />

  <div class="cases__grid">
    {
      cases.map((c, i) => (
        <a class="case" href={caseUrl(lang, c.data.key)} data-reveal data-hover>
          <div class={`case__visual case__visual--${i % 2}`}>
            <CaseVisual kind={c.data.kind} variant="card" />
          </div>
          <div class="case__body">
            <div class="case__meta">
              {c.data.concept && <span class="case__badge t-label">{t.conceptBadge}</span>}
              <span class="case__client t-label">
                {c.data.clinic} · {c.data.place}
              </span>
            </div>
            <h3 class="case__title">{c.data.title}</h3>
            <ul class="case__impact" role="list">
              {c.data.highlights.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
            <span class="case__more t-label">
              {t.readMore} <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .cases {
    color: var(--c-paper);
  }

  /* Section head sits on dark here, repaint its light-theme pieces */
  .cases :global(.shead__chip) {
    background: transparent;
    border-color: rgb(255 255 255 / 0.18);
    color: rgb(255 255 255 / 0.65);
  }

  .cases :global(.shead__title) {
    color: var(--c-paper);
  }

  .cases :global(.shead__sub) {
    color: rgb(255 255 255 / 0.55);
  }

  .cases__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .case {
    display: flex;
    flex-direction: column;
    background: #232326;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 1.25rem;
    overflow: clip;
    transition:
      border-color 0.4s var(--ease-out-expo),
      transform 0.6s var(--ease-out-expo);
  }

  .case:hover {
    border-color: rgb(255 255 255 / 0.22);
    transform: translateY(-4px);
  }

  .case__visual {
    aspect-ratio: 16 / 10;
    overflow: clip;
  }

  .case__visual--0 {
    background: radial-gradient(120% 130% at 20% 0%, var(--c-accent), var(--c-accent-deep) 75%);
  }

  .case__visual--1 {
    background: radial-gradient(120% 130% at 80% 0%, #3a3a40, #161618 75%);
  }

  .case__visual :global(.phone) {
    transition: transform 0.8s var(--ease-out-expo);
  }

  .case:hover .case__visual :global(.phone) {
    transform: translateY(-0.6em);
  }

  .case__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.5rem, 2.5vw, 2rem);
    flex: 1;
  }

  .case__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .case__badge {
    border: 1px solid color-mix(in srgb, var(--c-accent) 60%, transparent);
    color: #ff8a5c;
    border-radius: 99px;
    padding: 0.35rem 0.75rem;
  }

  .case__client {
    color: rgb(255 255 255 / 0.5);
  }

  .case__title {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .case__impact {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.9rem;
    color: rgb(255 255 255 / 0.65);
  }

  .case__impact li::before {
    content: "·";
    color: var(--c-accent);
    font-weight: 700;
    margin-right: 0.6rem;
  }

  .case__more {
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--c-paper);
  }

  @media (max-width: 820px) {
    .cases__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
