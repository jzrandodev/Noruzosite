---
import SectionHead from "./SectionHead.astro";
import { strings, type Lang } from "../i18n/strings";
interface Props {
  lang: Lang;
}
const t = strings[Astro.props.lang].services;
const m = t.mock;
---

<section class="services section" id="services" data-theme-section="light">
  <SectionHead chip={t.chip} title={t.title} sub={t.sub} />

  <ul class="services__list">
    {
      t.items.map((s) => (
        <li class="feat" data-service-row>
          <div class="feat__text">
            <span class="feat__chip t-label">{s.chip}</span>
            <h3 class="feat__title t-display t-display--md">{s.title}</h3>
            <p class="feat__body">{s.blurb}</p>
            <ul class="feat__tags" role="list">
              {s.tags.map((tag) => (
                <li class="t-label">{tag}</li>
              ))}
            </ul>
            <p class="feat__price">{s.price}</p>
          </div>

          <div class="feat__visual" aria-hidden="true">
            {s.kind === "site" && (
              <div class="mock mock--site">
                <div class="mock__browser">
                  <div class="mock__dots">
                    <i /><i /><i />
                  </div>
                  <div class="mock__lang">
                    <span class="is-on">ES</span>
                    <span>EN</span>
                  </div>
                </div>
                <div class="mock__sitenav">
                  {m.siteNav.map((n) => <span>{n}</span>)}
                </div>
                <p class="mock__headline">{m.siteHeadline}</p>
                <p class="mock__sub">{m.siteSub}</p>
                <span class="mock__btn">{m.siteCta}</span>
                <div class="mock__slots">
                  <span>9:00</span>
                  <span class="is-on">10:30</span>
                  <span>12:00</span>
                  <span>3:15</span>
                </div>
              </div>
            )}
            {s.kind === "chat" && (
              <div class="mock mock--wa">
                <div class="mock__wahead">
                  <span class="mock__avatar" />
                  <span>{m.chatHeader}</span>
                </div>
                <div class="mock__bubble">
                  <p>{m.chatMsg}</p>
                  <div class="mock__actions">
                    <span>{m.chatConfirm}</span>
                    <span>{m.chatChange}</span>
                  </div>
                </div>
                <div class="mock__bubble mock__bubble--me">{m.chatReply}</div>
              </div>
            )}
            {s.kind === "dash" && (
              <div class="mock mock--dash">
                <div class="mock__bar">{m.dashTitle}</div>
                <div class="mock__stat">
                  <span>{m.dashStats[0]}</span>
                  <div class="mock__meter"><i style="width: 72%" /></div>
                </div>
                <div class="mock__stat">
                  <span>{m.dashStats[1]}</span>
                  <div class="mock__meter"><i style="width: 86%" /></div>
                </div>
                <div class="mock__stat">
                  <span>{m.dashStats[2]}</span>
                  <div class="mock__meter"><i style="width: 64%" /></div>
                </div>
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .services__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: clamp(4rem, 10vh, 7rem);
  }

  .feat {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .feat:nth-child(even) .feat__visual {
    order: -1;
  }

  .feat__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 30rem;
  }

  .feat__chip {
    border: 1px solid var(--c-line);
    background: var(--c-paper);
    padding: 0.5rem 1rem;
    border-radius: 99px;
    color: var(--c-ink-soft);
  }

  .feat__title {
    color: var(--c-ink);
  }

  .feat__body {
    color: var(--c-ink-soft);
    line-height: 1.65;
  }

  .feat__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .feat__tags li {
    border: 1px solid var(--c-line);
    background: var(--c-paper);
    border-radius: 99px;
    padding: 0.45rem 0.9rem;
    color: var(--c-ink);
  }

  /* ---- mockup cards ---- */

  .mock {
    background: var(--c-paper);
    border: 1px solid var(--c-line);
    border-radius: 1.25rem;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    box-shadow: 0 32px 64px -40px rgb(28 28 30 / 0.25);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    min-height: 280px;
    justify-content: center;
  }

  .mock__bar {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--c-ink);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--c-line);
  }

  .mock__row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--c-line);
    border-radius: 0.75rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--c-ink);
  }

  .mock__row small {
    display: block;
    font-size: 0.72rem;
    color: var(--c-ink-soft);
    font-weight: 400;
  }

  .mock__row--hot {
    border-color: color-mix(in srgb, var(--c-accent) 35%, transparent);
    background: color-mix(in srgb, var(--c-accent) 5%, transparent);
  }

  .mock__check {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    border: 1.5px solid var(--c-line);
    border-radius: 0.35rem;
  }

  .mock__check--done {
    background: var(--c-accent);
    border-color: var(--c-accent);
  }

  .mock--chat {
    align-items: center;
    text-align: center;
  }

  .mock__orb {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 30%, #ff9d6b, var(--c-accent) 58%, var(--c-accent-deep));
  }

  .mock__q {
    font-weight: 600;
    color: var(--c-ink);
  }

  .mock__input {
    width: 100%;
    border: 1px solid var(--c-line);
    border-radius: 99px;
    padding: 0.8rem 1.2rem;
    font-size: 0.85rem;
    color: var(--c-ink-soft);
    text-align: left;
  }

  .mock__type {
    display: inline-block;
    white-space: nowrap;
  }

  .mock__chips {
    display: flex;
    gap: 0.5rem;
  }

  .mock__chips span {
    font-size: 0.72rem;
    font-weight: 500;
    border: 1px solid var(--c-line);
    border-radius: 99px;
    padding: 0.35rem 0.8rem;
    color: var(--c-ink-soft);
  }

  .mock__dots {
    display: flex;
    gap: 0.4rem;
  }

  .mock__dots i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--c-line);
  }

  .mock__code {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1rem 0;
  }

  .mock__code span {
    display: block;
    height: 0.55rem;
    border-radius: 99px;
    background: var(--c-bg);
  }

  .mock__code .mock__code--accent {
    background: color-mix(in srgb, var(--c-accent) 30%, var(--c-bg));
  }

  .mock__deploy {
    font-size: 0.78rem;
    font-weight: 500;
    color: #1d9e4b;
  }

  .mock__stat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--c-ink);
  }

  .mock__meter {
    height: 0.55rem;
    border-radius: 99px;
    background: var(--c-bg);
    overflow: clip;
  }

  .mock__meter i {
    display: block;
    height: 100%;
    border-radius: 99px;
    background: var(--c-accent);
  }

  .feat__price {
    margin-top: 0.25rem;
    font-weight: 600;
    color: var(--c-ink);
  }

  /* ---- website mock ---- */

  .mock__browser {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--c-line);
  }

  .mock__lang {
    display: flex;
    border: 1px solid var(--c-line);
    border-radius: 99px;
    padding: 0.15rem;
    font-size: 0.68rem;
    font-weight: 600;
  }

  .mock__lang span {
    padding: 0.2rem 0.55rem;
    border-radius: 99px;
    color: var(--c-ink-soft);
  }

  .mock__lang .is-on {
    background: var(--c-ink);
    color: var(--c-paper);
  }

  .mock__sitenav {
    display: flex;
    gap: 1rem;
    font-size: 0.72rem;
    color: var(--c-ink-soft);
  }

  .mock__headline {
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--c-ink);
  }

  .mock__sub {
    font-size: 0.82rem;
    color: var(--c-ink-soft);
  }

  .mock__btn {
    align-self: flex-start;
    background: var(--c-accent);
    color: var(--c-paper);
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 99px;
    padding: 0.6rem 1.1rem;
  }

  .mock__slots {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .mock__slots span {
    font-size: 0.75rem;
    font-weight: 500;
    border: 1px solid var(--c-line);
    border-radius: 0.5rem;
    padding: 0.4rem 0.7rem;
    color: var(--c-ink);
  }

  .mock__slots .is-on {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  /* ---- WhatsApp reminder mock ---- */

  .mock--wa {
    background: #efeae2;
  }

  .mock__wahead {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--c-ink);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgb(0 0 0 / 0.08);
  }

  .mock__avatar {
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 30%, #ff9d6b, var(--c-accent) 58%, var(--c-accent-deep));
  }

  .mock__bubble {
    align-self: flex-start;
    max-width: 85%;
    background: var(--c-paper);
    border-radius: 0.2rem 0.9rem 0.9rem 0.9rem;
    padding: 0.75rem 0.9rem;
    font-size: 0.85rem;
    color: var(--c-ink);
    box-shadow: 0 1px 1px rgb(0 0 0 / 0.06);
  }

  .mock__actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.7rem;
  }

  .mock__actions span {
    flex: 1;
    text-align: center;
    font-size: 0.78rem;
    font-weight: 600;
    color: #128c7e;
    border: 1px solid rgb(18 140 126 / 0.3);
    border-radius: 0.5rem;
    padding: 0.4rem 0.6rem;
  }

  .mock__bubble--me {
    align-self: flex-end;
    background: #d9fdd3;
    border-radius: 0.9rem 0.2rem 0.9rem 0.9rem;
    font-weight: 500;
  }

  @media (max-width: 820px) {
    .feat {
      grid-template-columns: 1fr;
    }

    .feat:nth-child(even) .feat__visual {
      order: 0;
    }
  }
</style>
