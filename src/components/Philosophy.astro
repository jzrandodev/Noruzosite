---
import { strings, type Lang } from "../i18n/strings";
interface Props {
  lang: Lang;
}
const t = strings[Astro.props.lang].philosophy;
---

<section class="philosophy section" id="philosophy" data-theme-section="dark">
  <p class="philosophy__label t-label" data-reveal>{t.label}</p>

  <p class="philosophy__manifesto t-display t-display--md" data-split>
    {t.manifesto}
  </p>
</section>

<style>
  .philosophy {
    min-height: 90svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3rem;
  }

  .philosophy__label {
    color: var(--c-accent);
  }

  .philosophy__manifesto {
    max-width: min(100%, 1080px);
    color: var(--c-paper);
    font-weight: 500;
  }
</style>
