---
// Thin bar on every demo page so nobody mistakes a fictional clinic for a real one.
import { url } from "../../i18n/strings";
interface Props {
  clinic: string;
  back: string; // case study path (no base), e.g. "work/ceibo-dental/"
}
const { clinic, back } = Astro.props;
---

<div class="demo-banner" role="note">
  <span>
    <b data-i18n="demo.label">Example by Noruzo</b>
    <span class="demo-banner__sep" aria-hidden="true">·</span>
    <span data-i18n="demo.fictional" data-clinic={clinic}>{clinic} is an example practice</span>
  </span>
  <a href={url(back)} data-i18n="demo.back">See the example →</a>
</div>

<style>
  .demo-banner {
    position: relative;
    z-index: 60;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.55rem 1rem;
    background: #1c1c1e;
    color: #f2f2f2;
    font: 500 0.78rem/1.3 "Inter Variable", system-ui, sans-serif;
  }

  .demo-banner b {
    color: #ff7a45;
    font-weight: 600;
  }

  .demo-banner__sep {
    margin: 0 0.4rem;
    opacity: 0.5;
  }

  .demo-banner a {
    color: #f2f2f2;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
