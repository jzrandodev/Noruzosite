---
// Extra visual sections for the concept case studies:
// website → before/after, system → patient flow.
import type { Lang } from "../i18n/strings";

interface Props {
  kind: "website" | "system";
  lang: Lang;
}
const { kind, lang } = Astro.props;

const copy = {
  en: {
    baTitle: "Before and after",
    baSub: "What a typical neighborhood clinic site looks like on a phone today, and the redesign.",
    before: "Typical today",
    after: "Redesign",
    beforeNotes: [
      "English first, machine translation on top",
      "Hours and insurance buried in menus",
      "Booking means calling",
    ],
    afterNotes: [
      "Spanish first, written by a person",
      "The three big questions answered up top",
      "Book in 3 steps from the phone",
    ],
    flowTitle: "How the system works",
    flowSub: "Two flows run on their own. Orange steps are automatic. The front desk only steps in when a patient doesn't answer.",
    lanes: [
      {
        name: "Missed call",
        steps: [
          { who: "Patient", text: "Calls during the lunch rush. Nobody picks up." },
          { who: "System", text: "Texts back in under a minute, in the patient's language, with a booking link." },
          { who: "Patient", text: "Books online, or replies to get a call back." },
          { who: "Front desk", text: "Only calls back the ones who asked.", end: true },
        ],
      },
      {
        name: "Upcoming visit",
        steps: [
          { who: "48 hours before", text: "WhatsApp reminder with Confirm and Change buttons." },
          { who: "Patient taps Change", text: "Picks a new time. The old slot opens for the waitlist." },
          { who: "2 hours before", text: "Short nudge with the address and a map link." },
          { who: "No answer", text: "Flagged on the front desk screen for a quick call.", end: true },
        ],
      },
    ],
  },
  es: {
    baTitle: "Antes y después",
    baSub: "Cómo se ve hoy en el celular el sitio típico de una clínica de barrio, y el rediseño.",
    before: "Lo típico hoy",
    after: "Rediseño",
    beforeNotes: [
      "Inglés primero, traductor automático encima",
      "Horarios y seguros escondidos en menús",
      "Para reservar hay que llamar",
    ],
    afterNotes: [
      "Español primero, escrito por una persona",
      "Las tres grandes preguntas respondidas arriba",
      "Reserva en 3 pasos desde el celular",
    ],
    flowTitle: "Cómo funciona el sistema",
    flowSub: "Dos flujos funcionan solos. Los pasos en naranja son automáticos. La recepción solo interviene cuando un paciente no responde.",
    lanes: [
      {
        name: "Llamada perdida",
        steps: [
          { who: "Paciente", text: "Llama a la hora del almuerzo. Nadie atiende." },
          { who: "Sistema", text: "Le escribe en menos de un minuto, en su idioma, con un enlace para reservar." },
          { who: "Paciente", text: "Reserva en línea o responde para que lo llamen." },
          { who: "Recepción", text: "Solo llama a quienes lo pidieron.", end: true },
        ],
      },
      {
        name: "Próxima cita",
        steps: [
          { who: "48 horas antes", text: "Recordatorio por WhatsApp con botones Confirmar y Cambiar." },
          { who: "El paciente toca Cambiar", text: "Elige otro horario. El anterior se libera para la lista de espera." },
          { who: "2 horas antes", text: "Aviso corto con la dirección y un enlace al mapa." },
          { who: "Sin respuesta", text: "Aparece marcado en la pantalla de recepción para una llamada rápida.", end: true },
        ],
      },
    ],
  },
}[lang];
---

{
  kind === "website" && (
    <section class="cx section" aria-labelledby="cx-ba">
      <header class="cx__head">
        <h2 id="cx-ba" class="cx__title">{copy.baTitle}</h2>
        <p class="cx__sub">{copy.baSub}</p>
      </header>

      <div class="ba">
        <figure class="ba__col">
          <figcaption class="ba__label t-label ba__label--before">{copy.before}</figcaption>
          <div class="old" aria-hidden="true">
            <div class="old__bar">
              <span class="old__logo">Ceibo Dental P.C.</span>
              <span class="old__menu">☰</span>
            </div>
            <div class="old__translate">
              <span>Select Language ▾</span>
              <small>Powered by Translate</small>
            </div>
            <div class="old__hero">
              <p>Welcome to Our Practice</p>
            </div>
            <p class="old__text">
              Ceibo Dental P.C. is committed to providing comprehensive, high quality dental care in a comfortable
              environment. Our experienced team utilizes state-of-the-art technology to deliver...
            </p>
            <span class="old__link">Insurance Accepted (PDF)</span>
            <span class="old__phone">Call to schedule: (212) 555-0100</span>
          </div>
          <ul class="ba__notes ba__notes--before" role="list">
            {copy.beforeNotes.map((n) => <li>{n}</li>)}
          </ul>
        </figure>

        <figure class="ba__col">
          <figcaption class="ba__label t-label ba__label--after">{copy.after}</figcaption>
          <div class="new" aria-hidden="true">
            <div class="new__top">
              <span class="new__brand">
                Ceibo<b>Dental</b>
              </span>
              <span class="new__lang">
                <i class="is-on">ES</i>
                <i>EN</i>
              </span>
            </div>
            <p class="new__h">Tu dentista de confianza en Washington Heights</p>
            <div class="new__chips">
              <span>Abierto sábados</span>
              <span>Aceptamos Medicaid</span>
              <span>Limpieza desde $95</span>
            </div>
            <span class="new__btn">Reservar cita</span>
            <span class="new__ghost">Escríbenos por WhatsApp</span>
          </div>
          <ul class="ba__notes ba__notes--after" role="list">
            {copy.afterNotes.map((n) => <li>{n}</li>)}
          </ul>
        </figure>
      </div>
    </section>
  )
}

{
  kind === "system" && (
    <section class="cx section" aria-labelledby="cx-flow">
      <header class="cx__head">
        <h2 id="cx-flow" class="cx__title">{copy.flowTitle}</h2>
        <p class="cx__sub">{copy.flowSub}</p>
      </header>

      <div class="flow">
        {copy.lanes.map((lane, li) => (
          <div class="lane">
            <p class="lane__name t-label">{lane.name}</p>
            <ol class="lane__steps" role="list">
              {lane.steps.map((s, i) => (
                <li class:list={["step", { "step--end": s.end, "step--sys": (li === 0 ? [1] : [0, 2]).includes(i) }]}>
                  <span class="step__n">{i + 1}</span>
                  <span class="step__who">{s.who}</span>
                  <span class="step__text">{s.text}</span>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </section>
  )
}

<style>
  .cx {
    padding-top: 0;
  }

  .cx__head {
    max-width: 42rem;
    margin: 0 auto clamp(2rem, 5vh, 3rem);
    text-align: center;
  }

  .cx__title {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .cx__sub {
    margin-top: 0.75rem;
    color: var(--c-ink-soft);
    line-height: 1.6;
  }

  /* ---------- before / after ---------- */

  .ba {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 22rem));
    justify-content: center;
    gap: clamp(1.5rem, 6vw, 5rem);
  }

  .ba__col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .ba__label {
    border-radius: 99px;
    padding: 0.4rem 0.9rem;
  }

  .ba__label--before {
    background: #ececea;
    color: var(--c-ink-soft);
  }

  .ba__label--after {
    background: color-mix(in srgb, var(--c-accent) 12%, var(--c-paper));
    color: var(--c-accent-deep);
  }

  .old,
  .new {
    width: 17rem;
    min-height: 25rem;
    border: 0.45rem solid #1c1c1e;
    border-radius: 1.75rem;
    overflow: clip;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2rem 4rem -2rem rgb(0 0 0 / 0.3);
    background: var(--c-paper);
  }

  /* the "before": dated, generic, English-first */
  .old {
    font-family: Georgia, "Times New Roman", serif;
    color: #333;
  }

  .old__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #1f3b73;
    color: #fff;
    padding: 0.8rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .old__translate {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.4rem 0.9rem;
    background: #f1f1f1;
    border-bottom: 1px solid #ddd;
    font-family: Arial, sans-serif;
    font-size: 0.62rem;
    color: #555;
  }

  .old__translate small {
    font-size: 0.55rem;
    color: #999;
  }

  .old__hero {
    height: 6.5rem;
    background: linear-gradient(135deg, #8ea7c7, #c9d6e6);
    display: grid;
    place-items: center;
  }

  .old__hero p {
    color: #fff;
    font-size: 1.05rem;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.3);
  }

  .old__text {
    padding: 0.9rem;
    font-size: 0.7rem;
    line-height: 1.55;
  }

  .old__link,
  .old__phone {
    margin: 0 0.9rem 0.6rem;
    font-family: Arial, sans-serif;
    font-size: 0.66rem;
  }

  .old__link {
    color: #1a4fd6;
    text-decoration: underline;
  }

  .old__phone {
    color: #777;
  }

  /* the "after" */
  .new {
    gap: 0.8rem;
    padding: 1.2rem 1.1rem;
  }

  .new__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--c-line);
  }

  .new__brand {
    font-size: 0.85rem;
    font-weight: 500;
  }

  .new__brand b {
    color: var(--c-accent);
  }

  .new__lang {
    display: flex;
    border: 1px solid var(--c-line);
    border-radius: 99px;
    padding: 0.12rem;
    font-size: 0.62rem;
    font-weight: 700;
  }

  .new__lang i {
    font-style: normal;
    padding: 0.2rem 0.55rem;
    border-radius: 99px;
    color: var(--c-ink-soft);
  }

  .new__lang .is-on {
    background: var(--c-ink);
    color: var(--c-paper);
  }

  .new__h {
    font-size: 1.3rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .new__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .new__chips span {
    font-size: 0.68rem;
    font-weight: 600;
    background: color-mix(in srgb, var(--c-accent) 9%, var(--c-paper));
    color: var(--c-accent-deep);
    border-radius: 99px;
    padding: 0.35rem 0.7rem;
  }

  .new__btn,
  .new__ghost {
    display: block;
    text-align: center;
    border-radius: 99px;
    font-size: 0.8rem;
    font-weight: 650;
    padding: 0.8rem 1rem;
  }

  .new__btn {
    margin-top: auto;
    background: var(--c-accent);
    color: var(--c-paper);
  }

  .new__ghost {
    border: 1px solid var(--c-line);
    color: #128c7e;
  }

  .ba__notes {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.92rem;
    width: 17rem;
  }

  .ba__notes li {
    display: flex;
    gap: 0.6rem;
  }

  .ba__notes--before li {
    color: var(--c-ink-soft);
  }

  .ba__notes--before li::before {
    content: "×";
    color: #b0b0b0;
    font-weight: 700;
  }

  .ba__notes--after li::before {
    content: "✓";
    color: var(--c-accent);
    font-weight: 700;
  }

  /* ---------- flow ---------- */

  .flow {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .lane {
    background: var(--c-paper);
    border: 1px solid var(--c-line);
    border-radius: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .lane__name {
    color: var(--c-accent-deep);
    margin-bottom: 1.25rem;
  }

  .lane__steps {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 2rem 1fr;
    column-gap: 1rem;
    padding-bottom: 1.5rem;
  }

  /* connector line between step dots */
  .step::before {
    content: "";
    position: absolute;
    left: calc(1rem - 1px);
    top: 2rem;
    bottom: 0;
    width: 2px;
    background: var(--c-line);
  }

  .step--end {
    padding-bottom: 0;
  }

  .step--end::before {
    display: none;
  }

  .step__n {
    grid-row: span 2;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    font-weight: 700;
    background: var(--c-bg);
    border: 1px solid var(--c-line);
    color: var(--c-ink);
  }

  .step--sys .step__n {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-paper);
  }

  .step__who {
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 2rem;
  }

  .step__text {
    color: var(--c-ink-soft);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .ba,
    .flow {
      grid-template-columns: 1fr;
    }

    .ba {
      justify-items: center;
    }
  }
</style>
