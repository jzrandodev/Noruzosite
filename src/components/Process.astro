---
import SectionHead from "./SectionHead.astro";

const steps = [
  {
    n: "01",
    title: "Audit",
    blurb:
      "We review your website, booking and phones in both languages and show you exactly where patients get stuck.",
  },
  {
    n: "02",
    title: "Design",
    blurb:
      "We design a site that's clear, calm and easy to use on a phone, with Spanish copy reviewed by a native medical translator.",
  },
  {
    n: "03",
    title: "Launch",
    blurb:
      "We build, launch and set up booking and front desk tools, then show your team how everything works.",
  },
  {
    n: "04",
    title: "Care",
    blurb:
      "We keep your site and tools up to date every month, so you can focus on patients instead of your website.",
  },
];
---

<section class="process section" id="process" data-theme-section="light">
  <SectionHead
    chip="Our process"
    title='Simple from start to <em class="t-tilt">finish</em>'
    sub="Four steps, one person to talk to, no tech jargon."
  />

  <div class="process__wrap">
    <span class="process__line" data-process-line aria-hidden="true"></span>
    <ol class="process__list" role="list">
      {
        steps.map((s) => (
          <li class="prow" data-service-row>
            <span class="prow__num t-tilt" aria-hidden="true">{s.n}</span>
            <h3 class="prow__title t-display t-display--md">{s.title}</h3>
            <p class="prow__body">{s.blurb}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process__wrap {
    position: relative;
    padding-left: clamp(1.75rem, 4vw, 3.5rem);
  }

  .process__line {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--c-accent);
    transform-origin: top;
  }

  .process__list {
    list-style: none;
  }

  .prow {
    display: grid;
    grid-template-columns: 6rem 1fr minmax(16rem, 26rem);
    gap: 2rem;
    align-items: baseline;
    padding: clamp(2rem, 4vh, 3rem) 0;
    border-top: 1px solid var(--c-line);
  }

  .prow:last-child {
    border-bottom: 1px solid var(--c-line);
  }

  .prow__num {
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    line-height: 1;
  }

  .prow__title {
    color: var(--c-ink);
  }

  .prow__body {
    color: var(--c-ink-soft);
    line-height: 1.65;
    font-size: 0.95rem;
  }

  @media (max-width: 860px) {
    .prow {
      grid-template-columns: 4rem 1fr;
    }

    .prow__body {
      grid-column: 2;
    }
  }
</style>
