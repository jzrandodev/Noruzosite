      const SERVICES = [
        { icon: "✦", es: ["Limpieza y revisión", "Cada 6 meses. Incluye radiografías."], en: ["Cleaning and checkup", "Every 6 months. X-rays included."], price: 95 },
        { icon: "◐", es: ["Empastes", "Del color de tu diente, en una sola visita."], en: ["Fillings", "Tooth-colored, done in one visit."], price: 150 },
        { icon: "✚", es: ["Urgencias", "Dolor o diente roto. Te vemos el mismo día."], en: ["Emergencies", "Pain or a broken tooth. Seen same day."], price: 120 },
        { icon: "☺", es: ["Niños", "Primera visita desde el primer diente."], en: ["Kids", "First visit from the first tooth."], price: 75 },
