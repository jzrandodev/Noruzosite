      const qs = new URLSearchParams(location.search);
      const stored = (() => {
        try {
          return localStorage.getItem("ceibo-lang");
        } catch {
          return null;
        }
      })();
      let lang: L =
        (qs.get("lang") as L) ||
        (stored as L) ||
        "es"; // Spanish-first by design
      if (lang !== "en" && lang !== "es") lang = "es";

      const t = (k: string, vars: Record<string, string> = {}) =>
        (T[lang][k] ?? k).replace(/\{(\w)\}/g, (_, v) => vars[v] ?? "");

      const $ = <E extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<E>(s)!;
      const $$ = <E extends Element = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll<E>(s)];

      function renderStatic() {
        document.documentElement.lang = lang;
        for (const el of $$("[data-i18n]")) {
          const key = el.dataset.i18n!;
          el.textContent = t(key, { c: el.dataset.clinic ?? "" });
        }
        for (const b of $$<HTMLButtonElement>("[data-lang-btn]")) {
          b.setAttribute("aria-pressed", String(b.dataset.langBtn === lang));
        }
        $("[data-next-time]").textContent = t("next.time");
        $<HTMLInputElement>("[data-ins-input]").placeholder = t("ins.ph");

        $("[data-services]").innerHTML = SERVICES.map(
          (s) => `<li class="svc__item">
              <span class="svc__icon" aria-hidden="true">${s.icon}</span>
              <div><b>${s[lang][0]}</b><p>${s[lang][1]}</p></div>
              <span class="svc__price"><small>${t("from")}</small>$${s.price}</span>
            </li>`,
        ).join("");

        $("[data-faq]").innerHTML = FAQ[lang]
          .map(([q, a]) => `<details class="faq__item"><summary>${q}</summary><p>${a}</p></details>`)
          .join("");

        const msg = lang === "es" ? "Hola, quiero reservar una cita en Ceibo Dental." : "Hi, I'd like to book a visit at Ceibo Dental.";
        for (const a of $$<HTMLAnchorElement>("[data-wa]")) {
          a.href = `https://wa.me/12125550142?text=${encodeURIComponent(msg)}`;
          a.target = "_blank";
          a.rel = "noopener noreferrer";
        }
        renderInsurance();
        renderBooking();
      }

      // ---- insurance checker ----
      const insInput = $<HTMLInputElement>("[data-ins-input]");
      function renderInsurance() {
        const q = insInput.value.trim().toLowerCase();
        const hits = q ? INSURANCE.filter((p) => p.toLowerCase().includes(q)) : INSURANCE;
        $("[data-ins-list]").innerHTML = hits
          .map((p) => `<li class="${q ? "is-hit" : ""}"><span aria-hidden="true">✓</span>${p}</li>`)
          .join("");
        const res = $("[data-ins-result]");
        res.className = "ins__result";
        if (!q) {
          res.textContent = "";
        } else if (hits.length) {
          res.textContent = t("ins.yes", { p: hits[0] });
          res.classList.add("is-yes");
        } else {
          res.textContent = t("ins.no", { p: insInput.value.trim() });
          res.classList.add("is-no");
        }
      }
      insInput.addEventListener("input", renderInsurance);

      // ---- booking ----
      const sheet = $("[data-sheet]");
      const state = { step: 1, reason: -1, day: 1, slot: "", name: "", phone: "", via: "wa" };

      function renderBooking() {
        $("[data-step-label]").textContent = state.step <= 3 ? t("bk.step", { n: String(state.step) }) : "";
        ($("[data-step-bar]") as HTMLElement).style.width = `${Math.min(state.step, 3) * 33.34}%`;
        for (const s of $$("[data-step]")) s.hidden = Number(s.dataset.step) !== state.step;

        $("[data-reasons]").innerHTML = REASONS[lang]
          .map(
            ([r, d], i) =>
              `<button type="button" class="opt ${state.reason === i ? "is-on" : ""}" data-reason="${i}"><b>${r}</b><span>${d}</span></button>`,
          )
          .join("");

        $("[data-days]").innerHTML = DAYS[lang]
          .map((d, i) => `<button type="button" class="day ${state.day === i ? "is-on" : ""}" data-day="${i}">${d}</button>`)
          .join("");
        $("[data-slots]").innerHTML = SLOTS[state.day]
          .map((s) => `<button type="button" class="slot ${state.slot === s ? "is-on" : ""}" data-slot="${s}">${s}</button>`)
          .join("");

        const nav = $("[data-nav]");
        nav.hidden = state.step >= 3;
        ($("[data-back]") as HTMLButtonElement).style.visibility = state.step > 1 ? "visible" : "hidden";
        ($("[data-next]") as HTMLButtonElement).disabled =
          (state.step === 1 && state.reason < 0) || (state.step === 2 && !state.slot);

        if (state.step === 4) {
          const raw = DAYS[lang][state.day];
          const day = state.day < 2 ? raw.toLowerCase() : raw;
          $("[data-done-title]").textContent = t("bk.done", { n: state.name });
          $("[data-done-sum]").textContent = t("bk.sum", { r: REASONS[lang][state.reason][0], d: DAYS[lang][state.day], t: state.slot });
          $("[data-done-msg]").textContent = t("bk.msg", { n: state.name, d: day, t: state.slot });
        }
      }

      function open(next = false) {
        Object.assign(state, { step: 1, reason: -1, day: 1, slot: "" });
        if (next) Object.assign(state, { step: 2, reason: 0, day: 0, slot: "3:15 pm" });
        $<HTMLFormElement>("[data-form]").reset();
        $("[data-err]").textContent = "";
        renderBooking();
        sheet.hidden = false;
        document.body.classList.add("no-scroll");
        requestAnimationFrame(() => sheet.classList.add("is-open"));
      }
      function close() {
        sheet.classList.remove("is-open");
        document.body.classList.remove("no-scroll");
        setTimeout(() => (sheet.hidden = true), 300);
      }

      document.addEventListener("click", (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>(
          "[data-open-booking],[data-close-booking],[data-reason],[data-day],[data-slot],[data-next],[data-back],[data-lang-btn]",
        );
        if (!el) return;
        if (el.dataset.langBtn) {
          lang = el.dataset.langBtn as L;
          try {
            localStorage.setItem("ceibo-lang", lang);
          } catch {}
          renderStatic();
        } else if (el.hasAttribute("data-open-booking")) open(el.hasAttribute("data-book-next"));
        else if (el.hasAttribute("data-close-booking")) close();
        else if (el.dataset.reason) {
          state.reason = Number(el.dataset.reason);
          renderBooking();
        } else if (el.dataset.day) {
          state.day = Number(el.dataset.day);
          state.slot = "";
          renderBooking();
        } else if (el.dataset.slot) {
          state.slot = el.dataset.slot;
          renderBooking();
        } else if (el.hasAttribute("data-next")) {
          state.step += 1;
          renderBooking();
        } else if (el.hasAttribute("data-back")) {
          state.step = Math.max(1, state.step - 1);
          renderBooking();
        }
      });

      $<HTMLFormElement>("[data-form]").addEventListener("submit", (e) => {
        e.preventDefault();
        const f = e.target as HTMLFormElement;
        const name = (f.elements.namedItem("name") as HTMLInputElement).value.trim();
        const phone = (f.elements.namedItem("phone") as HTMLInputElement).value.replace(/\D/g, "");
        if (!name || phone.length < 10) {
          $("[data-err]").textContent = t("bk.err");
          return;
        }
        state.name = name.split(" ")[0];
        state.phone = phone;
        state.step = 4;
        renderBooking();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !sheet.hidden) close();
      });

      renderStatic();
    </script>
  </body>
</html>

