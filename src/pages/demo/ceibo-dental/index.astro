---
import "@fontsource-variable/inter";
import "@fontsource-variable/fraunces";
import DemoBanner from "../../../components/demo/DemoBanner.astro";
import { url } from "../../../i18n/strings";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ceibo Dental · Example by Noruzo</title>
    <meta name="description" content="Example by Noruzo: a Spanish-first website for an example family dental practice." />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#fbf7f1" />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
  </head>
  <body>
    <DemoBanner clinic="Ceibo Dental" back="work/ceibo-dental/" />

    <header class="hdr" data-hdr>
      <a class="logo" href="#inicio" aria-label="Ceibo Dental">
        <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
          <circle cx="16" cy="16" r="16" fill="var(--red)" />
          <path d="M16 7c2.6 3 3.8 5.8 3.8 8.3 0 2.6-1.6 4.4-3.8 4.4s-3.8-1.8-3.8-4.4C12.2 12.8 13.4 10 16 7z" fill="#fbf7f1" />
          <path d="M16 19.7V25" stroke="#fbf7f1" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <span>Ceibo <em>Dental</em></span>
      </a>
      <nav class="hdr__nav" aria-label="Principal">
        <a href="#servicios" data-i18n="nav.services">Servicios</a>
        <a href="#seguros" data-i18n="nav.insurance">Seguros</a>
        <a href="#equipo" data-i18n="nav.team">Equipo</a>
        <a href="#visita" data-i18n="nav.visit">Visítanos</a>
      </nav>
      <div class="hdr__right">
        <div class="lang" role="group" aria-label="Idioma / Language">
          <button type="button" data-lang-btn="es" aria-pressed="true">Español</button>
          <button type="button" data-lang-btn="en" aria-pressed="false">English</button>
        </div>
        <button class="btn btn--sm" type="button" data-open-booking data-i18n="cta.book">Reservar cita</button>
      </div>
    </header>

    <main id="inicio">
      <section class="hero">
        <div class="hero__text">
          <p class="eyebrow" data-i18n="hero.eyebrow">Dentista familiar en Washington Heights</p>
          <h1 data-i18n="hero.title">Tu sonrisa, en tu idioma.</h1>
          <p class="hero__sub" data-i18n="hero.sub">
            Limpiezas, empastes y urgencias para toda la familia. Te atendemos en español, sin vueltas y con precios claros.
          </p>
          <ul class="chips" role="list">
            <li data-i18n="hero.chip1">Abierto sábados</li>
            <li data-i18n="hero.chip2">Aceptamos Medicaid</li>
            <li data-i18n="hero.chip3">Limpieza desde $95</li>
          </ul>
          <div class="hero__ctas">
            <button class="btn" type="button" data-open-booking data-i18n="cta.book">Reservar cita</button>
            <a class="btn btn--wa" href="#" data-wa>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.4-.3z"/></svg>
              <span data-i18n="cta.whatsapp">Escríbenos por WhatsApp</span>
            </a>
          </div>
        </div>

        <aside class="next" aria-live="polite">
          <p class="next__label" data-i18n="next.label">Próximo horario disponible</p>
          <p class="next__time" data-next-time>Hoy, 3:15 pm</p>
          <p class="next__who" data-i18n="next.who">con la Dra. Valeria Ríos</p>
          <button class="btn btn--ghost" type="button" data-open-booking data-book-next data-i18n="next.cta">Reservar este horario</button>
          <div class="next__art" aria-hidden="true">
            <span class="blob blob--1"></span>
            <span class="blob blob--2"></span>
            <span class="blob blob--3"></span>
          </div>
        </aside>
      </section>

      <section class="facts" aria-label="Datos rápidos">
        <div class="fact">
          <span class="fact__icon" aria-hidden="true">◷</span>
          <div>
            <b data-i18n="facts.hoursT">Horario</b>
            <span data-i18n="facts.hours">Lun a vie 9 am a 7 pm · Sáb 9 am a 2 pm</span>
          </div>
        </div>
        <div class="fact">
          <span class="fact__icon" aria-hidden="true">✚</span>
          <div>
            <b data-i18n="facts.insT">Seguros</b>
            <span data-i18n="facts.ins">Medicaid, Fidelis, Healthfirst, MetroPlus y más</span>
          </div>
        </div>
        <div class="fact">
          <span class="fact__icon" aria-hidden="true">⌖</span>
          <div>
            <b data-i18n="facts.whereT">Dónde</b>
            <span data-i18n="facts.where">Broadway y W 174th St · Tren A y 1</span>
          </div>
        </div>
      </section>

      <section class="sec" id="servicios">
        <header class="sec__head">
          <p class="eyebrow" data-i18n="svc.eyebrow">Servicios</p>
          <h2 data-i18n="svc.title">Precios claros, sin sorpresas</h2>
          <p data-i18n="svc.sub">Precios de referencia sin seguro. Con seguro, muchas veces pagas $0. Te confirmamos antes de empezar.</p>
        </header>
        <ul class="svc" role="list" data-services></ul>
      </section>

      <section class="sec sec--tint" id="seguros">
        <header class="sec__head">
          <p class="eyebrow" data-i18n="ins.eyebrow">Seguros</p>
          <h2 data-i18n="ins.title">¿Aceptan mi seguro?</h2>
          <p data-i18n="ins.sub">Escribe el nombre de tu plan y te decimos al instante.</p>
        </header>
        <div class="ins">
          <label class="visually-hidden" for="ins-q" data-i18n="ins.label">Nombre de tu seguro</label>
          <input id="ins-q" class="ins__input" type="search" autocomplete="off" data-ins-input placeholder="Ej: Medicaid, Fidelis…" />
          <p class="ins__result" data-ins-result aria-live="polite"></p>
          <ul class="ins__list" role="list" data-ins-list></ul>
        </div>
      </section>

      <section class="sec" id="equipo">
        <header class="sec__head">
          <p class="eyebrow" data-i18n="team.eyebrow">Equipo</p>
          <h2 data-i18n="team.title">Te atendemos en tu idioma</h2>
        </header>
        <ul class="team" role="list">
          <li class="doc">
            <span class="doc__av" aria-hidden="true">VR</span>
            <b>Dra. Valeria Ríos</b>
            <span data-i18n="team.d1">Odontología general · Habla español e inglés</span>
          </li>
          <li class="doc">
            <span class="doc__av doc__av--2" aria-hidden="true">MP</span>
            <b>Dr. Martín Peña</b>
            <span data-i18n="team.d2">Odontopediatría · Habla español e inglés</span>
          </li>
          <li class="doc">
            <span class="doc__av doc__av--3" aria-hidden="true">LC</span>
            <b>Lucía Cabrera</b>
            <span data-i18n="team.d3">Recepción · Te ayuda con seguros y pagos</span>
          </li>
        </ul>
      </section>

      <section class="sec sec--tint" id="faq">
        <header class="sec__head">
          <p class="eyebrow">FAQ</p>
          <h2 data-i18n="faq.title">Preguntas frecuentes</h2>
        </header>
        <div class="faq" data-faq></div>
      </section>

      <section class="sec visit" id="visita">
        <div>
          <p class="eyebrow" data-i18n="visit.eyebrow">Visítanos</p>
          <h2 data-i18n="visit.title">Estamos a dos cuadras del tren</h2>
          <p data-i18n="visit.addr">Broadway y W 174th St, Washington Heights, NY</p>
          <p>(212) 555-0142</p>
          <div class="hero__ctas">
            <button class="btn" type="button" data-open-booking data-i18n="cta.book">Reservar cita</button>
          </div>
        </div>
        <div class="map" aria-hidden="true">
          <span class="map__road map__road--1"></span>
          <span class="map__road map__road--2"></span>
          <span class="map__road map__road--3"></span>
          <span class="map__pin"></span>
          <span class="map__label">Ceibo Dental</span>
          <span class="map__train">A · 1</span>
        </div>
      </section>
    </main>

    <footer class="ftr">
      <span>© Ceibo Dental</span>
      <span data-i18n="footer.note">Sitio de ejemplo diseñado por Noruzo.</span>
    </footer>

    <a class="fab" href="#" data-wa aria-label="WhatsApp">
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z"/></svg>
    </a>

    <!-- Booking flow -->
    <div class="sheet" data-sheet hidden>
      <div class="sheet__scrim" data-close-booking></div>
      <div class="sheet__panel" role="dialog" aria-modal="true" aria-labelledby="sheet-title">
        <div class="sheet__top">
          <p class="sheet__step" data-step-label></p>
          <button class="sheet__x" type="button" data-close-booking aria-label="Cerrar">✕</button>
        </div>
        <div class="sheet__bar"><span data-step-bar></span></div>

        <!-- step 1 -->
        <div class="step" data-step="1">
          <h2 id="sheet-title" data-i18n="bk.s1">¿Por qué nos visitas?</h2>
          <div class="opts" data-reasons></div>
        </div>

        <!-- step 2 -->
        <div class="step" data-step="2" hidden>
          <h2 data-i18n="bk.s2">Elige un horario</h2>
          <div class="days" data-days></div>
          <div class="slots" data-slots></div>
          <p class="hint" data-i18n="bk.hint">Te confirmamos por WhatsApp o texto, como prefieras.</p>
        </div>

        <!-- step 3 -->
        <form class="step" data-step="3" hidden data-form novalidate>
          <h2 data-i18n="bk.s3">¿A nombre de quién?</h2>
          <label class="field">
            <span data-i18n="bk.name">Nombre</span>
            <input name="name" autocomplete="given-name" required />
          </label>
          <label class="field">
            <span data-i18n="bk.phone">Celular</span>
            <input name="phone" inputmode="tel" autocomplete="tel" required />
          </label>
          <fieldset class="field">
            <legend data-i18n="bk.via">¿Cómo te confirmamos?</legend>
            <div class="seg">
              <label><input type="radio" name="via" value="wa" checked /> <span>WhatsApp</span></label>
              <label><input type="radio" name="via" value="sms" /> <span data-i18n="bk.sms">Mensaje de texto</span></label>
            </div>
          </fieldset>
          <p class="hint" data-i18n="bk.privacy">No te pedimos información médica aquí. Eso lo vemos en persona.</p>
          <p class="err" data-err aria-live="polite"></p>
          <button class="btn btn--block" type="submit" data-i18n="bk.confirm">Confirmar cita</button>
        </form>

        <!-- done -->
        <div class="step done" data-step="4" hidden>
          <span class="done__check" aria-hidden="true">✓</span>
          <h2 data-done-title>¡Listo!</h2>
          <p class="done__sum" data-done-sum></p>
          <div class="wa-prev">
            <p class="wa-prev__head">Ceibo Dental · WhatsApp</p>
            <div class="wa-prev__bub" data-done-msg></div>
          </div>
          <button class="btn btn--ghost btn--block" type="button" data-close-booking data-i18n="bk.close">Volver al sitio</button>
        </div>

        <div class="sheet__nav" data-nav>
          <button class="link" type="button" data-back data-i18n="bk.back">← Atrás</button>
          <button class="btn" type="button" data-next disabled data-i18n="bk.next">Continuar</button>
        </div>
      </div>
    </div>

