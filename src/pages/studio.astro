---
import "@fontsource-variable/inter";
import "../styles/base.css";

const title = "Noruzo Studio";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
  </head>
  <body data-theme="light" class="studio-body">
    <!-- LOGIN VIEW -->
    <section class="login" data-login hidden>
      <form class="login__card" data-login-form>
        <h1 class="login__title">Noruzo Studio</h1>
        <p class="login__sub">Private. Sign in to continue.</p>
        <label class="field">
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label class="field">
          <span>Password</span>
          <input type="password" name="password" autocomplete="current-password" required />
        </label>
        <button class="btn btn--solid" type="submit" data-login-submit>Sign in</button>
        <button class="btn btn--ghost" type="button" data-forgot>Forgot password</button>
        <p class="login__status" data-login-status role="status" aria-live="polite"></p>
      </form>
    </section>

    <!-- APP VIEW -->
    <main class="app" data-app hidden>
      <header class="app__bar">
        <span class="app__brand">Noruzo&nbsp;Studio</span>
        <div class="app__bar-right">
          <a class="app__link" data-blog-link href="#">View blog ↗</a>
          <span class="app__who" data-who></span>
          <button class="btn btn--ghost" type="button" data-signout>Sign out</button>
        </div>
      </header>

      <!-- INPUT -->
      <section class="card input">
        <div class="seg" role="tablist">
          <button class="seg__btn is-active" type="button" data-mode="braindump" role="tab">Brain dump</button>
          <button class="seg__btn" type="button" data-mode="youtube" role="tab">YouTube</button>
        </div>

        <div data-panel="braindump">
          <textarea
            class="ta"
            data-input-text
            rows="6"
            placeholder="Talk it out in text — the idea, the story, the point you want to make. A paragraph or three is plenty."></textarea>
        </div>

        <div data-panel="youtube" hidden>
          <input class="ti" type="url" data-input-url placeholder="https://www.youtube.com/watch?v=…" />
          <div data-transcript-fallback hidden>
            <p class="hint">Couldn't pull that video's transcript automatically. Paste it here and we'll use it.</p>
            <textarea class="ta" data-input-transcript rows="6" placeholder="Paste the transcript…"></textarea>
          </div>
        </div>

        <div class="input__actions">
          <button class="btn btn--solid" type="button" data-generate>Generate</button>
          <span class="status" data-gen-status role="status" aria-live="polite"></span>
        </div>
      </section>

      <!-- OUTPUTS -->
      <section class="outputs" data-outputs hidden>
        <!-- LinkedIn -->
        <article class="card panel" data-panel-linkedin>
          <div class="panel__head">
            <h2>LinkedIn</h2>
            <span class="count" data-li-count></span>
          </div>
          <textarea class="ta" data-li-body rows="10"></textarea>
          <div class="panel__actions">
            <button class="btn btn--ghost" type="button" data-li-copy>Copy</button>
            <button class="btn btn--ghost" type="button" data-li-save>Save</button>
          </div>
        </article>

        <!-- Blog -->
        <article class="card panel" data-panel-blog>
          <div class="panel__head">
            <h2>Blog post</h2>
            <span class="badge" data-blog-status></span>
          </div>
          <input class="ti" data-blog-title placeholder="Title" />
          <input class="ti" data-blog-slug placeholder="slug-in-the-url" />
          <textarea class="ta ta--sm" data-blog-excerpt rows="2" placeholder="One-line excerpt"></textarea>
          <textarea class="ta" data-blog-body rows="14" placeholder="Body (Markdown)"></textarea>
          <div class="panel__actions">
            <button class="btn btn--ghost" type="button" data-blog-copy>Copy</button>
            <button class="btn btn--ghost" type="button" data-blog-save>Save</button>
            <button class="btn btn--solid" type="button" data-blog-publish>Publish</button>
            <a class="app__link" data-blog-view href="#" hidden>View ↗</a>
          </div>
        </article>

        <!-- X thread -->
        <article class="card panel" data-panel-x>
          <div class="panel__head">
            <h2>X thread</h2>
            <button class="btn btn--ghost btn--xs" type="button" data-x-add>+ tweet</button>
          </div>
          <div data-x-thread></div>
          <div class="panel__actions">
            <button class="btn btn--ghost" type="button" data-x-copy>Copy</button>
            <button class="btn btn--ghost" type="button" data-x-save>Save</button>
            <button class="btn btn--solid" type="button" data-x-post>Post to X</button>
          </div>
        </article>
      </section>

      <!-- HISTORY -->
      <section class="card history">
        <h2 class="history__title">Recent</h2>
        <ul class="history__list" data-history></ul>
      </section>
    </main>

    <script src="../scripts/studio.ts"></script>

    <style>
      .studio-body {
        background: var(--c-bg);
        color: var(--c-ink);
        font-family: var(--font-body);
        min-height: 100vh;
      }

      /* Login */
      .login {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem;
      }
      .login__card {
        width: 100%;
        max-width: 22rem;
        background: var(--c-paper);
        border: 1px solid var(--c-line);
        border-radius: 1.25rem;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
      }
      .login__title { font-size: 1.5rem; font-weight: 600; }
      .login__sub { color: var(--c-ink-soft); font-size: 0.9rem; margin-bottom: 0.5rem; }
      .login__status { min-height: 1.2em; font-size: 0.85rem; color: #e23636; }
      .login__status.is-ok { color: #1d9e4b; }

      .field { display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.85rem; }
      .field span { color: var(--c-ink-soft); }
      .field input { padding: 0.7rem 0.9rem; border: 1px solid var(--c-line); border-radius: 0.6rem; background: var(--c-paper); color: var(--c-ink); }
      .field input:focus { outline: none; border-color: var(--c-accent); }

      /* App shell */
      .app { max-width: 60rem; margin: 0 auto; padding: 1.5rem clamp(1rem, 4vw, 2rem) 5rem; }
      .app__bar { display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0 1.5rem; }
      .app__brand { font-weight: 600; letter-spacing: -0.01em; }
      .app__bar-right { display: flex; align-items: center; gap: 1rem; }
      .app__who { font-size: 0.8rem; color: var(--c-ink-soft); }
      .app__link { font-size: 0.85rem; color: var(--c-accent); text-decoration: none; }
      .app__link:hover { text-decoration: underline; }

      .card {
        background: var(--c-paper);
        border: 1px solid var(--c-line);
        border-radius: 1rem;
        padding: 1.25rem;
        margin-bottom: 1.25rem;
      }

      .seg { display: inline-flex; gap: 0.25rem; background: var(--c-bg); padding: 0.25rem; border-radius: 0.7rem; margin-bottom: 1rem; }
      .seg__btn { padding: 0.45rem 1rem; border-radius: 0.5rem; font-size: 0.85rem; color: var(--c-ink-soft); background: transparent; }
      .seg__btn.is-active { background: var(--c-paper); color: var(--c-ink); box-shadow: 0 1px 2px rgba(0,0,0,0.05); }

      .ta, .ti {
        width: 100%;
        padding: 0.8rem 1rem;
        border: 1px solid var(--c-line);
        border-radius: 0.7rem;
        background: var(--c-paper);
        color: var(--c-ink);
        font-family: var(--font-body);
        font-size: 0.95rem;
        line-height: 1.5;
        resize: vertical;
      }
      .ta--sm { min-height: auto; }
      .ti { margin-bottom: 0.6rem; }
      .ta:focus, .ti:focus { outline: none; border-color: var(--c-accent); }

      .input__actions { display: flex; align-items: center; gap: 1rem; margin-top: 1rem; }
      .status, .hint { font-size: 0.85rem; color: var(--c-ink-soft); }
      .status.is-error { color: #e23636; }
      .status.is-ok { color: #1d9e4b; }
      .hint { margin: 0.75rem 0 0.5rem; }

      .outputs { display: grid; gap: 1.25rem; }
      .panel__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.85rem; }
      .panel__head h2 { font-size: 1rem; font-weight: 600; }
      .panel__actions { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; margin-top: 0.85rem; }
      .count { font-size: 0.8rem; color: var(--c-ink-soft); }
      .badge { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--c-ink-soft); }
      .badge.is-pub { color: #1d9e4b; }

      .x-tweet { position: relative; margin-bottom: 0.6rem; }
      .x-tweet__count { position: absolute; right: 0.7rem; bottom: 0.55rem; font-size: 0.72rem; color: var(--c-ink-soft); pointer-events: none; }
      .x-tweet__count.is-over { color: #e23636; }
      .x-tweet__del { position: absolute; right: 0.5rem; top: 0.5rem; font-size: 0.75rem; color: var(--c-ink-soft); background: transparent; }

      .history__title { font-size: 1rem; font-weight: 600; margin-bottom: 0.85rem; }
      .history__list { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; }
      .history__item { display: flex; justify-content: space-between; gap: 1rem; padding: 0.6rem 0.8rem; border: 1px solid var(--c-line); border-radius: 0.6rem; cursor: pointer; font-size: 0.88rem; }
      .history__item:hover { border-color: var(--c-accent); }
      .history__item time { color: var(--c-ink-soft); font-size: 0.78rem; white-space: nowrap; }

      /* Buttons */
      .btn { padding: 0.6rem 1.1rem; border-radius: 0.6rem; font-size: 0.85rem; font-weight: 500; cursor: pointer; transition: background-color 0.2s, border-color 0.2s, opacity 0.2s; }
      .btn--solid { background: var(--c-ink); color: var(--c-paper); }
      .btn--solid:hover { background: var(--c-accent); }
      .btn--ghost { background: transparent; border: 1px solid var(--c-line); color: var(--c-ink); }
      .btn--ghost:hover { border-color: var(--c-accent); color: var(--c-accent); }
      .btn--xs { padding: 0.3rem 0.7rem; font-size: 0.78rem; }
      .btn:disabled { opacity: 0.55; cursor: default; }
    </style>
  </body>
</html>
